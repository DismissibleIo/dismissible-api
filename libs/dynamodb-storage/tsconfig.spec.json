{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node", "jest"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2021",
    "rootDir": ".."
  },
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts", "bin/**/*.js"]
}
